{
  "businesses": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "name",
          "currency",
          "openingOnlineBalance",
          "openingCashBalance",
          "vendors",
          "expenseCategories"
        ],
        "properties": {
          "_id": {
            "bsonType": "string"
          },
          "name": {
            "bsonType": "string"
          },
          "currency": {
            "enum": [
              "INR"
            ]
          },
          "dateFormat": {
            "bsonType": "string"
          },
          "openingOnlineBalance": {
            "bsonType": "number"
          },
          "openingCashBalance": {
            "bsonType": "number"
          },
          "vendors": {
            "bsonType": "array",
            "items": {
              "bsonType": "string"
            }
          },
          "expenseCategories": {
            "bsonType": "array",
            "items": {
              "bsonType": "string"
            }
          },
          "updatedAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "name": 1
      }
    ]
  },
  "dailyEntries": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "businessId",
          "date",
          "onlineSales",
          "cashSales",
          "expenses",
          "expensePaidOnline",
          "expensePaidCash"
        ],
        "properties": {
          "businessId": {
            "bsonType": "string"
          },
          "date": {
            "bsonType": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "onlineSales": {
            "bsonType": "number"
          },
          "cashSales": {
            "bsonType": "number"
          },
          "expenses": {
            "bsonType": "object"
          },
          "expensePaidOnline": {
            "bsonType": "number"
          },
          "expensePaidCash": {
            "bsonType": "number"
          },
          "notes": {
            "bsonType": "string"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "businessId": 1,
        "date": 1
      },
      {
        "businessId": 1,
        "date": -1
      }
    ]
  },
  "purchaseEntries": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "businessId",
          "purchaseDate",
          "vendorAmounts",
          "onlinePurchasePaid",
          "cashPurchasePaid"
        ],
        "properties": {
          "businessId": {
            "bsonType": "string"
          },
          "purchaseDate": {
            "bsonType": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "paymentDate": {
            "bsonType": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "vendorAmounts": {
            "bsonType": "object"
          },
          "onlinePurchasePaid": {
            "bsonType": "number"
          },
          "cashPurchasePaid": {
            "bsonType": "number"
          },
          "createdAt": {
            "bsonType": "date"
          },
          "updatedAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "businessId": 1,
        "purchaseDate": 1
      },
      {
        "businessId": 1,
        "paymentDate": 1
      }
    ]
  },
  "monthlyFinance": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["businessId", "period", "year", "month", "salaries", "truckEmi", "autoEmi", "roomRent", "savingsDeposit", "partnerPayments", "updatedAt"],
        "properties": {
          "businessId": { "bsonType": "string" },
          "period": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "year": { "bsonType": "int" },
          "month": { "bsonType": "int", "minimum": 1, "maximum": 12 },
          "salaries": { "bsonType": "array", "items": { "bsonType": "object", "required": ["person", "amount"], "properties": { "person": { "bsonType": "string" }, "amount": { "bsonType": "number", "minimum": 0 }, "paymentDate": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } } },
          "truckEmi": { "bsonType": "number", "minimum": 0 },
          "truckEmiPaymentDate": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "autoEmi": { "bsonType": "number", "minimum": 0 },
          "autoEmiPaymentDate": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "roomRent": { "bsonType": "number", "minimum": 0 },
          "savingsDeposit": { "bsonType": "number", "minimum": 0 },
          "partnerPayments": { "bsonType": "array", "items": { "bsonType": "object", "required": ["partner", "amount"], "properties": { "partner": { "bsonType": "string" }, "amount": { "bsonType": "number", "minimum": 0 }, "paymentDate": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } } },
          "updatedAt": { "bsonType": "date" }
        }
      }
    },
    "indexes": [{ "businessId": 1, "period": 1 }]
  },
  "financeLoans": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["businessId", "person", "source", "amountTaken", "takenDate", "repayments", "notes", "createdAt", "updatedAt"],
        "properties": {
          "businessId": { "bsonType": "string" },
          "person": { "bsonType": "string" },
          "source": { "enum": ["friend", "partner", "other"] },
          "amountTaken": { "bsonType": "number", "minimum": 0 },
          "takenDate": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "repayments": { "bsonType": "array", "items": { "bsonType": "object", "required": ["date", "amount"], "properties": { "date": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "amount": { "bsonType": "number", "minimum": 0 } } } },
          "notes": { "bsonType": "string" },
          "createdAt": { "bsonType": "date" },
          "updatedAt": { "bsonType": "date" }
        }
      }
    },
    "indexes": [{ "businessId": 1, "takenDate": -1 }]
  },
  "vendorDefectReturns": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["businessId", "vendor", "returnDate", "amount", "receipts", "notes", "createdAt", "updatedAt"],
        "properties": {
          "businessId": { "bsonType": "string" },
          "vendor": { "bsonType": "string" },
          "returnDate": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "amount": { "bsonType": "number", "minimum": 0 },
          "receipts": { "bsonType": "array", "items": { "bsonType": "object", "required": ["date", "amount"], "properties": { "date": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "amount": { "bsonType": "number", "minimum": 0 } } } },
          "notes": { "bsonType": "string" },
          "createdAt": { "bsonType": "date" },
          "updatedAt": { "bsonType": "date" }
        }
      }
    },
    "indexes": [{ "businessId": 1, "returnDate": -1 }]
  },
  "users": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "email",
          "businessId",
          "role"
        ],
        "properties": {
          "email": {
            "bsonType": "string"
          },
          "passwordHash": {
            "bsonType": "string"
          },
          "businessId": {
            "bsonType": "string"
          },
          "role": {
            "enum": [
              "owner",
              "staff",
              "viewer"
            ]
          },
          "createdAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "email": 1
      },
      {
        "businessId": 1,
        "email": 1
      }
    ]
  },
  "auditLogs": {
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "businessId",
          "action",
          "collection",
          "createdAt"
        ],
        "properties": {
          "businessId": {
            "bsonType": "string"
          },
          "userId": {
            "bsonType": "string"
          },
          "action": {
            "bsonType": "string"
          },
          "collection": {
            "bsonType": "string"
          },
          "documentId": {
            "bsonType": "string"
          },
          "before": {
            "bsonType": "object"
          },
          "after": {
            "bsonType": "object"
          },
          "createdAt": {
            "bsonType": "date"
          }
        }
      }
    },
    "indexes": [
      {
        "businessId": 1,
        "createdAt": -1
      }
    ]
  }
}